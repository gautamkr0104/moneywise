# ---------------------------------------------------------------------------
# MoneyWise environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Flask runtime configuration
# FLASK_ENV selects the config class: development | testing | production
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_APP=run.py

# Secret key used to sign session cookies and CSRF tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database URL.
# SQLite (default):    sqlite:///moneywise.db  (stored in instance/)
# PostgreSQL example:  postgresql+psycopg://user:password@localhost:5432/moneywise
DATABASE_URL=sqlite:///moneywise.db

# Maximum accepted upload size in bytes (default 5 MB) - used for CSV imports.
MAX_CONTENT_LENGTH=5242880
